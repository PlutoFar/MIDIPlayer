<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MidiPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="MIDI 播放器">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}"
          Loaded="OnRootLoaded"
          AllowDrop="True" DragOver="OnRootDragOver" Drop="OnRootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="OnPlayAccelerator" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- 背景图层：处理后的图片与遮罩；无图时显示纯色背景。 -->
        <Image x:Name="BgImage" Grid.RowSpan="2" Stretch="UniformToFill" Visibility="Collapsed" />
        <Rectangle x:Name="BgOverlay" Grid.RowSpan="2" Visibility="Collapsed" />

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock Text="MIDI 播放器" Margin="12,0,0,0"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextSecondaryBrush}" />
        </Grid>

        <muxc:NavigationView x:Name="Nav" Grid.Row="1"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="Collapsed"
                             PaneDisplayMode="Left"
                             OpenPaneLength="200"
                             Background="{ThemeResource NavigationPanelBackgroundBrush}"
                             SelectionChanged="OnNavSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Tag="library" Content="乐器库">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8D6;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Tag="playlist" Content="播放列表">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE90B;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Tag="background" Content="背景">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE91B;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Tag="fonts" Content="字体">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8D2;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Tag="settings" Content="设置">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

                <muxc:NavigationView.PaneFooter>
                <ToggleButton x:Name="PinButton" Margin="4,0,4,8"
                              Background="Transparent" BorderThickness="0"
                              AutomationProperties.Name="窗口置顶"
                              ToolTipService.ToolTip="窗口置顶"
                              Click="OnPinToggled">
                    <FontIcon x:Name="PinIcon" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE718;" FontSize="16" />
                </ToggleButton>
            </muxc:NavigationView.PaneFooter>

            <!-- 内容区：头部 + 页面 + 走带条 -->
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部 -->
                <Grid Grid.Row="0" Padding="24,16,24,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Grid.Column="0" Text="乐器库"
                               FontSize="26" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <ComboBox x:Name="PluginCombo" Grid.Column="2" MinWidth="280" MaxWidth="520"
                              VerticalAlignment="Center" PlaceholderText="选择乐器..."
                              AutomationProperties.Name="乐器插件"
                              SelectionChanged="OnPluginComboChanged" />
                        <muxc:ProgressRing x:Name="ScanSpinner" Grid.Column="3"
                                       AutomationProperties.Name="插件扫描进度"
                                       Width="20" Height="20" IsActive="False"
                                       Visibility="Collapsed" VerticalAlignment="Center" />
                    <Button x:Name="ScanButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="扫描插件"
                            ToolTipService.ToolTip="扫描插件" Click="OnScan">
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE9A1;" />
                    </Button>
                    <Button x:Name="UnloadButton" Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="卸载插件"
                            ToolTipService.ToolTip="卸载插件" Click="OnUnload">
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE74D;" />
                    </Button>
                    <Button x:Name="EditorButton" Grid.Column="6" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="打开插件界面"
                            ToolTipService.ToolTip="打开插件界面" Click="OnEditor">
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8A7;" />
                    </Button>
                    <Button x:Name="ExportButton" Grid.Column="7" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="导出音频"
                            ToolTipService.ToolTip="导出音频" Click="OnExport">
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xEDE1;" />
                    </Button>
                </Grid>

                <!-- 页面容器（可见性切换） -->
                <Border Grid.Row="1" Margin="24,8,24,8" Padding="16"
                        Background="{ThemeResource ContentPanelBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                    <!-- 乐器库页 -->
                    <Grid x:Name="LibraryPanel">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8D6;"
                                      FontSize="48" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Name="LibraryHint" Text="选择一个 VST3 乐器插件开始演奏"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 播放列表页 -->
                    <Grid x:Name="PlaylistPanel" Visibility="Collapsed" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <Button Content="添加" Click="OnAddFiles" />
                            <Button Content="清空" Click="OnClearPlaylist" />
                            <Button Content="保存" Click="OnSaveList" />
                            <Button Content="加载" Click="OnLoadList" />
                        </StackPanel>
                        <Grid Grid.Row="1" Padding="12,0,12,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="曲目" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="状态" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <ListView x:Name="PlaylistView"
                                      AutomationProperties.Name="播放列表"
                                      SelectionMode="Single"
                                      AllowDrop="True" CanReorderItems="True" CanDragItems="True"
                                      DoubleTapped="OnPlaylistDoubleTapped"
                                      RightTapped="OnPlaylistRightTapped"
                                      ContainerContentChanging="OnPlaylistContainerContentChanging"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="播放" Click="OnCtxPlay" />
                                        <MenuFlyoutItem Text="移除" Click="OnCtxRemove" />
                                        <MenuFlyoutItem Text="打开文件位置" Click="OnCtxReveal" />
                                    </MenuFlyout>
                                </ListView.ContextFlyout>
                            </ListView>
                            <Border x:Name="PlaylistEmptyDropZone"
                                    MinHeight="220"
                                    BorderBrush="{ThemeResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8E5;"
                                              FontSize="40" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="未添加 MIDI 文件"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <Button Content="添加 MIDI" Click="OnAddFiles" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TrackCountLabel" Grid.Row="3"
                                   Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
                    </Grid>

                    <!-- 背景设置页 -->
                    <ScrollViewer x:Name="BackgroundPanel" Visibility="Collapsed">
                        <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,112">
                            <TextBlock Text="背景图片" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="选择图片" Click="OnBgSelect" />
                                <Button Content="清除" Click="OnBgClear" />
                                <TextBlock x:Name="BgPathLabel" Text="未选择图片" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="RecentBgPanel" Orientation="Horizontal" Spacing="8" />

                            <TextBlock Text="图像效果" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="效果" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <ComboBox x:Name="BlurModeCombo" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="背景效果"
                                          SelectionChanged="OnBlurModeChanged">
                                    <ComboBoxItem Content="无" />
                                    <ComboBoxItem Content="高斯模糊" />
                                    <ComboBoxItem Content="Aero (毛玻璃)" />
                                    <ComboBoxItem Content="Acrylic (亚克力)" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="强度" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Slider x:Name="BlurRadiusSlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="50"
                                        AutomationProperties.Name="背景效果强度"
                                        StepFrequency="1" ValueChanged="OnBlurRadiusChanged" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="遮罩" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Slider x:Name="OverlaySlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1"
                                        AutomationProperties.Name="背景遮罩透明度"
                                        StepFrequency="0.05" ValueChanged="OnOverlayChanged" />
                            </Grid>
                            <CheckBox x:Name="MonetToggle" Content="自动提取主题色" Click="OnMonetToggled" />
                            <StackPanel x:Name="PalettePanel" Orientation="Horizontal" Spacing="8" />

                            <TextBlock Text="界面行为" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <CheckBox x:Name="SeqIconToggle" Content="更换原生顺序图标样式" Click="OnSeqIconToggled" />
                            <CheckBox x:Name="RememberToggle" Content="记住窗口位置和大小" Click="OnRememberToggled" />
                        </StackPanel>
                    </ScrollViewer>
                    <!-- 字体设置页 -->
                    <ScrollViewer x:Name="FontPanel" Visibility="Collapsed">
                        <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,112">
                            <TextBlock Text="界面字体" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <ComboBox x:Name="UiFontCombo" Width="320"
                                      AutomationProperties.Name="界面字体"
                                      SelectionChanged="OnUiFontChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="字号" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Slider x:Name="UiFontSizeSlider" Width="240" Minimum="12" Maximum="20"
                                        AutomationProperties.Name="界面字号"
                                        StepFrequency="1" ValueChanged="OnUiFontSizeChanged" />
                            </StackPanel>
                            <TextBlock Text="播放列表字体" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <ComboBox x:Name="PlaylistFontCombo" Width="320"
                                      AutomationProperties.Name="播放列表字体"
                                      SelectionChanged="OnPlaylistFontChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="字号" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Slider x:Name="PlaylistFontSizeSlider" Width="240" Minimum="12" Maximum="36"
                                        AutomationProperties.Name="播放列表字号"
                                        StepFrequency="1" ValueChanged="OnPlaylistFontSizeChanged" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 音频设置页 -->
                    <ScrollViewer x:Name="AudioPanel" Visibility="Collapsed">
                        <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,112">
                            <TextBlock Text="音频设备" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock x:Name="AudioStatusLabel" Text="未连接"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="输出设备" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <ComboBox x:Name="AudioDeviceCombo" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="音频输出设备"
                                          SelectionChanged="OnAudioDeviceChanged" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="采样率" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <ComboBox x:Name="SampleRateCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="音频采样率"
                                          SelectionChanged="OnSampleRateChanged" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="缓冲区" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <ComboBox x:Name="BufferSizeCombo" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="音频缓冲区大小"
                                          SelectionChanged="OnBufferSizeChanged" />
                            </Grid>
                            <Button Content="播放测试音" Click="OnTestSound" />
                            <Button x:Name="FileAssociationButton"
                                    AutomationProperties.Name="MIDI 文件关联"
                                    Click="OnFileAssociation" />
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 走带条 -->
                <Border Grid.Row="2" Background="{ThemeResource TransportBackgroundBrush}"
                        Padding="20,8" Height="92">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Slider x:Name="ProgressSlider" Grid.Row="0" Minimum="0" Maximum="1"
                                AutomationProperties.Name="播放进度"
                                StepFrequency="0.001" ThumbToolTipValueConverter="{x:Null}"
                                IsThumbToolTipEnabled="False" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：曲名 + 时间 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Grid x:Name="TrackClip" Height="22" SizeChanged="OnTrackClipSizeChanged">
                                    <TextBlock x:Name="TrackLabel" Text="未加载" FontWeight="SemiBold"
                                               TextWrapping="NoWrap" HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextPrimaryBrush}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="TrackScroll" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                                <TextBlock x:Name="TimeLabel" Text="0:00 / 0:00" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- 中：走带按钮 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button x:Name="PrevButton" Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="上一首"
                                        ToolTipService.ToolTip="上一首" Click="OnPrev">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE892;" />
                                </Button>
                                <Button x:Name="PlayButton" Width="44" Height="44" CornerRadius="22"
                                        Background="Transparent"
                                        BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="2"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="18"
                                        AutomationProperties.Name="播放或暂停"
                                        ToolTipService.ToolTip="播放/暂停" Click="OnPlayPause">
                                    <FontIcon x:Name="PlayIcon" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE768;" />
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="下一首"
                                        ToolTipService.ToolTip="下一首" Click="OnNext">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE893;" />
                                </Button>
                                <Button x:Name="StopButton" Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="停止"
                                        ToolTipService.ToolTip="停止" Click="OnStop">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE71A;" />
                                </Button>
                            </StackPanel>

                            <!-- 右：播放模式 + 静音 + 音量 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button x:Name="LoopModeButton" Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="播放模式"
                                        ToolTipService.ToolTip="播放模式" Click="OnLoopMode">
                                    <FontIcon x:Name="LoopModeIcon" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xEA42;" />
                                </Button>
                                <Button x:Name="MuteButton" Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="静音"
                                        ToolTipService.ToolTip="静音" Click="OnMute">
                                    <FontIcon x:Name="MuteIcon" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE995;" />
                                </Button>
                                <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="1"
                                        AutomationProperties.Name="音量"
                                        StepFrequency="0.01" Value="0.8" VerticalAlignment="Center"
                                        IsThumbToolTipEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </muxc:NavigationView>

        <!-- 模式切换提示浮层 -->
        <muxc:InfoBar x:Name="ModeToast" Grid.Row="1" IsOpen="False" IsClosable="False"
                      Severity="Informational"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Margin="0,16,0,0" MaxWidth="240" />

        <muxc:InfoBar x:Name="ExportBar" Grid.Row="1" IsOpen="False" IsClosable="True"
                      Severity="Informational"
                      HorizontalAlignment="Stretch" VerticalAlignment="Top"
                      Margin="220,52,16,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressBar x:Name="ExportProgressBar" Width="180" Minimum="0" Maximum="100"
                             AutomationProperties.Name="导出进度" />
                <Button x:Name="ExportCancelButton" Content="取消"
                        AutomationProperties.Name="取消导出"
                        Click="OnCancelExport" />
            </StackPanel>
        </muxc:InfoBar>

        <!-- 顶部通知（首次运行 / 设备回退） -->
        <muxc:InfoBar x:Name="NoticeBar" Grid.Row="1" IsOpen="False" IsClosable="True"
                      Severity="Warning"
                      HorizontalAlignment="Stretch" VerticalAlignment="Top"
                      Margin="220,8,16,0" />
    </Grid>
</Window>
